# Transient per-run artifacts (regenerated by `node run.js`).
results-*.json
phase-*.json
profiles-*.json
!profiles-combined.json

# Vendored Neutralinojs runtime binary (fetched from GitHub releases; ~2.8 MB)
# and the framework's scratch directory.
neu-app/neutralino-linux_x64
neu-app/.tmp/
neu-app/ext/

# CEF's on-disk cache, created and removed by run.js for the CEF runtime.
.cef-cache/

# Compiled subreaper wrapper (rebuilt on demand from tools/reaper.c).
tools/reaper

# profiles-combined.json is intentionally committed: it is the raw evidence
# behind benchmarks/ROYAL_RUMBLE_SHOWDOWN.md.
